[Unit]
Description=Nightaround Ops MCP (loopback only)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=nightaround-ops
Group=nightaround-ops
WorkingDirectory=/srv/nightaround-ops/current
Environment=HOME=/srv/nightaround-ops/state/home
Environment=PATH=/opt/nightaround-node22/bin:/usr/local/bin:/usr/bin:/bin
Environment=DESKTOP_COMMANDER_DISABLE_TELEMETRY=1
Environment=NIGHTAROUND_OPS_ROOT=/srv/nightaround-ops
Environment=NIGHTAROUND_OPS_AUDIT=/srv/nightaround-ops/audit/actions.jsonl
Environment=NIGHTAROUND_OPS_HOST=127.0.0.1
Environment=NIGHTAROUND_OPS_PORT=8765
Environment=NIGHTAROUND_OPS_CONTROLLED_TEST=0
EnvironmentFile=-/srv/nightaround-ops/config/release.env
ExecStart=/opt/nightaround-node22/bin/node /srv/nightaround-ops/current/dist/ops-http.js
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=15s
UMask=0077

PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectProc=invisible
ProcSubset=pid
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictSUIDSGID=no
RemoveIPC=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=169.254.169.254
SystemCallArchitectures=native
ReadWritePaths=/srv/nightaround-ops
ReadWritePaths=/srv/nightaround-mcp/content-automation-app
ReadWritePaths=/srv/nightaround-mcp/nightlife-bakeoffs-v1/repo
ReadWritePaths=/srv/nightaround-entity/offpage-entity-registrar
ReadWritePaths=/srv/ai-doer-mcp/nightlife-bakeoffs-v1/repo
MemoryHigh=640M
MemoryMax=768M
CPUQuota=80%
TasksMax=256
LimitNOFILE=4096

StandardOutput=journal
StandardError=journal
SyslogIdentifier=nightaround-ops

[Install]
WantedBy=multi-user.target